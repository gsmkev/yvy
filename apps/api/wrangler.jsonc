{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yvy-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // La web (apps/web) se compila a ./public y se sirve gratis como static assets (PRD-cloudflare §4.10).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/auth/*",
      "/sync/*",
      "/org/*",
      "/media/*",
      "/ingest/*",
      "/public/*",
      "/admin/*",
      "/me",
      "/me/*",
      "/events",
      "/devices",
      "/health",
      "/descargar-app",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yvy",
      // Reemplazar por el id que devuelve `wrangler d1 create yvy`
      "database_id": "16461d64-a4d7-4f19-ab75-6a67c216e376",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "yvy-media" },
    { "binding": "TILES", "bucket_name": "yvy-tiles" },
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "yvy-jobs" }],
    "consumers": [{ "queue": "yvy-jobs", "max_batch_size": 1, "max_retries": 3 }],
  },
  // Plan gratis: 5 cron triggers por cuenta (docs/PRD-cloudflare.md §4.8)
  "triggers": {
    "crons": ["0 */3 * * *", "0 11 * * *", "*/15 * * * *", "0 10 * * 1", "0 3 * * *"],
  },
  "vars": {
    "APP_ENV": "development",
    "ALLOW_SIGNUP": "true",
    "EMAIL_FROM": "Yvy <ingreso@yvy.example>",
    "MEDIA_BUCKET_NAME": "yvy-media",
    "MET_USER_AGENT": "Yvy/1.0 koeti.com.py",
    "TILES_PUBLIC_URL": "https://pub-REEMPLAZAR.r2.dev",
    "APP_URL": "http://localhost:8787",
    "OPS_EMAIL": "",
    // Emails del equipo de Yvy con acceso al panel interno (separados por coma)
    "ADMIN_EMAILS": "",
    // Demo pública (V-02): agregar DEMO_ORG_ID y DEMO_USER_ID (dueño de esa organización, plan 'demo') para activarla.
  },
}
